# Makefile_accel — CalculiX (master) + the optional Apple Accelerate / geometric-multigrid backend.
#   Tooling / APHYSICAL.  macOS (Apple Silicon); Homebrew gcc-14/gfortran-14 for the CalculiX body,
#   clang/clang++ for the accel objects (Apple Accelerate uses clang-only overloadable intrinsics).
#
# A DEFAULT build (make / make -f Makefile_MT) is byte-for-byte unaffected: every source hook is wrapped
# in #ifdef CCX_ACCEL / #ifdef CCX_ACCEL_ARROW (only this makefile defines them), and every accel feature
# is additionally env-gated at run time (default off) and falls back to the stock CalculiX path.
#
# Build (from src/), pointing at a SPOOLES tree with headers + a serial+MT spooles.a:
#   make -f Makefile_accel SPOOLES_DIR=/abs/path/to/built/SPOOLES
#
# Optional METIS user-ordering for the direct fallback (needs 32-bit idx_t metis; not used by the GMG path):
#   make -f Makefile_accel SPOOLES_DIR=... \
#        METIS_DEF="-DCCX_HAVE_METIS -I/opt/homebrew/opt/metis/include" \
#        METIS_LINK="-L/opt/homebrew/opt/metis/lib -lmetis"
#
# Run-time switches (all default OFF -> stock CalculiX behaviour):
#   CCX_ACCEL_SOLVE=auto|gmg|direct|float-pcg   symmetric-solve backend behind spooles()
#   CCX_ACCEL_OUT_DAT_FAST=<jobname.dat>        fast parallel C writer for the *EL PRINT,S block
#   CCX_ACCEL_OUT_FRD=bin|asc                   force binary/ascii .frd
#   CCX_ACCEL_OUT_ARROW=<path>                  dump nodal fields as Arrow IPC
#   CCX_ACCEL_VERBOSE=1                         per-phase backend logging

# plain '=' (not '?=') so these override make's built-in CC=cc / FC=f77 defaults; a command-line
# assignment (make CC=... FC=...) still takes precedence over these.
CC          = gcc-14
FC          = gfortran-14
CLANG       = clang
CLANGXX     = clang++

LIBOMP      ?= /opt/homebrew/opt/libomp
ARPACK      ?= /opt/homebrew/opt/arpack
SPOOLES_DIR ?= ../../SPOOLES.2.2
SPOOLES_A   ?= $(SPOOLES_DIR)/spooles.a
ARPACK_LIBS ?= -L$(ARPACK)/lib -larpack
ACCEL_ARCH  ?= -mcpu=apple-m3
METIS_DEF   ?=
METIS_LINK  ?=

# Arrow IPC field output is OPT-IN (ARROW=1) and requires nanoarrow vendored under src/arrow/.
# It is NOT bundled here: nanoarrow is Apache-2.0, kept out of this GPLv2 tree. Drop a nanoarrow
# amalgamation into src/arrow/{src,include} and build with ARROW=1 to enable CCX_ACCEL_OUT_ARROW.
ARROW ?= 0
ifeq ($(ARROW),1)
ARROW_DEF  = -DCCX_ACCEL_ARROW
ARROW_OBJS = ccx_arrowout.o na_core.o na_ipc.o na_flatcc.o
else
ARROW_DEF  =
ARROW_OBJS =
endif

CFLAGS = -Wall -O2 -fopenmp -I$(SPOOLES_DIR) -DARCH="Linux" -DSPOOLES -DARPACK -DMATRIXSTORAGE \
         -DUSE_MT=1 -DCCX_ACCEL $(ARROW_DEF)
FFLAGS = -Wall -O2 -fopenmp -cpp -DCCX_ACCEL

.c.o :
	$(CC) $(CFLAGS) -c $<
.f.o :
	$(FC) $(FFLAGS) -c $<

include Makefile.inc
SCCXMAIN = CalculiX.c
OCCXF = $(SCCXF:.f=.o)
OCCXC = $(SCCXC:.c=.o)

# ---- accel backend objects (clang / clang++, with their own flags — NOT the gcc .c.o rule) ----
ACCEL_OBJS = accel_solver.o gmg_solve.o ccx_fastdat.o
ARROW_INC  = -Iarrow/include

accel_solver.o: accel_solver.c accel.h
	$(CLANG) -O3 $(ACCEL_ARCH) $(METIS_DEF) -c accel_solver.c -o $@
gmg_solve.o: gmg_solve.cpp
	$(CLANGXX) -std=c++17 -O3 $(ACCEL_ARCH) -DNDEBUG -DACCELERATE_NEW_LAPACK \
	    -Xpreprocessor -fopenmp -I$(LIBOMP)/include -c gmg_solve.cpp -o $@
ccx_fastdat.o: ccx_fastdat.c
	$(CLANG) -O2 -Xpreprocessor -fopenmp -I$(LIBOMP)/include -c ccx_fastdat.c -o $@
ccx_arrowout.o: ccx_arrowout.c
	$(CLANG) -O2 $(ARROW_INC) -c ccx_arrowout.c -o $@
na_core.o: arrow/src/nanoarrow.c
	$(CLANG) -O2 $(ARROW_INC) -c $< -o $@
na_ipc.o: arrow/src/nanoarrow_ipc.c
	$(CLANG) -O2 $(ARROW_INC) -c $< -o $@
na_flatcc.o: arrow/src/flatcc.c
	$(CLANG) -O2 $(ARROW_INC) -c $< -o $@

ACCEL_LINK = $(SPOOLES_A) $(ARPACK_LIBS) -framework Accelerate \
             -L$(LIBOMP)/lib -lomp -lc++ -lm $(METIS_LINK)

ccx_accel: CalculiX_accel.a $(ACCEL_OBJS) $(ARROW_OBJS)
	-./date.pl
	$(CC) $(CFLAGS) -c CalculiX.c -o CalculiX.o
	$(FC) -fopenmp -Wall -O2 -o $@ CalculiX.o CalculiX_accel.a \
	    $(ACCEL_OBJS) $(ARROW_OBJS) $(ACCEL_LINK)

CalculiX_accel.a: $(OCCXF) $(OCCXC)
	ar r $@ $?

.PHONY: clean
clean:
	rm -f *.o *.a ccx_accel
